# ============================================================
# AI 会议角色扮演 - 配置文件模板
#
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 把下面每项的星号部分替换为你自己的真实密钥（星号只是占位示例）
#   3. 保存 .env 后启动/重启服务，设置页点「从 .env 导入」即可生效
#
# 说明：.env 已被 .gitignore 排除，你的密钥永远不会被提交/推送
# ============================================================

# ---- 阿里云 CosyVoice 语音合成（TTS，AI 说话用）----
# 厂商：阿里云百炼（https://bailian.console.aliyun.com）
# 模型：cosyvoice-v3.5-plus（语音合成大模型）
# 获取：百炼控制台 -> 语音合成 -> 专属 MaaS 端点页面可看到 API Key 与端点地址
# 示例：TTS_KEY=sk-ws-******************************（MaaS 专属 Key，sk-ws- 开头）
TTS_KEY=sk-ws-************************
# HTTP API 端点（MaaS 专属端点，控制台同页可查；示例已打码）
TTS_HTTP=https://ws-********.cn-beijing.maas.aliyuncs.com/api/v1
# WebSocket API 端点（把上面 HTTP 的 https 换 wss、/api/v1 换 /api-ws/v1/inference）
TTS_WS=wss://ws-********.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# 模型型号（当前使用 cosyvoice-v3.5-plus，可选 cosyvoice-v3.5 等档位）
TTS_MODEL=cosyvoice-v3.5-plus
# 语速（1.0 = 原速；1.2 稍快，更接近真人会议节奏）
TTS_SPEECH_RATE=1.2
# 复刻音色的 voice id（百炼控制台 -> 声音复刻 -> 每个音色有唯一 id，示例已打码）
# 王新月 / 高晴 = 两个复刻音色的名字，可改成你自己的音色名（需同步改代码 TTS_VOICES）
TTS_VOICE_WANGXINYUE=cosyvoice-v3.5-plus-bailian-************************
TTS_VOICE_GAOQING=cosyvoice-v3.5-plus-bailian-************************

# ---- 火山引擎 豆包流式语音识别 2.0（ASR，听你说话用）----
# 厂商：火山引擎（https://console.volcengine.com/audio/overview）
# 模型：bigmodel（sauc 协议流式识别）| 计费：时长版 ~1 元/小时
# 获取：控制台 -> 语音技术 -> 流式语音识别 -> 获取 API Key 与 App ID
# 示例：VOLC_ASR_TOKEN=********-****-****-****-************（UUID 格式的 API Key）
VOLC_ASR_TOKEN=********-****-****-****-************
# App ID（纯数字；新版鉴权可留空，仅 X-Api-Key 即可）
VOLC_ASR_APPID=**********
# 资源 ID 固定值：volc.seedasr.sauc.duration = 2.0 时长版
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 端点固定值（bigmodel 流式识别）
VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel

# ---- 服务端口（仅绑定本机，一般不用改）----
GATEWAY_PORT=8787
